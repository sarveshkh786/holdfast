# PayPal sandbox app: developer.paypal.com -> Apps & Credentials -> Sandbox -> Create App
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Optional: webhook id from the same app (Webhooks section) for signature verification
PAYPAL_WEBHOOK_ID=
CURRENCY=USD

# Claude (console.anthropic.com). Without it, an offline rule-based agent is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Or Google Gemini (free key at aistudio.google.com/apikey). Used if no Anthropic key.
GEMINI_API_KEY=

# Business timezone (slots are generated in this zone)
TZ=Asia/Kolkata
PORT=3000
